# Copy to .env and fill in. Never commit .env.

# App
APP_NAME=ExamRadar
APP_ENV=development            # development | staging | production
APP_BASE_URL=http://localhost:8000
SECRET_KEY=change-me           # long random string, used for sessions and signing

# Database and queue
DATABASE_URL=postgresql+psycopg://examradar:examradar@localhost:5432/examradar
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO locally, any S3-compatible service in production)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=examradar-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1

# Crawler
CRAWLER_USER_AGENT=ExamRadarBot/0.1 (+https://example.invalid/bot)   # set a real contact URL before crawling in production
CRAWLER_DEFAULT_MIN_DELAY_SECONDS=5

# LLM (optional; the pipeline runs without it)
LLM_PROVIDER=groq              # groq | none
GROQ_API_KEY=
GROQ_MODEL=

# Admin
ADMIN_BOOTSTRAP_EMAIL=         # first admin account, TOTP enrolment on first login

# Firebase (M5)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=     # path to service account JSON, outside the repo

# Observability
LOG_LEVEL=INFO
SENTRY_DSN=
