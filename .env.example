# Copy to .env and fill in. Never commit .env.

# App
APP_NAME=ExamRadar                 # working name; change freely
APP_ENV=development                # development | staging | production
APP_BASE_URL=http://localhost:8000 # public address of the API; the privacy policy is served at /privacy
SECRET_KEY=change-me               # long random string; signs admin sessions and CSRF tokens

# Database and queue
DATABASE_URL=sqlite:///storage/examradar.db   # production: postgresql+psycopg://USER:PASSWORD@HOST:5432/examradar
POSTGRES_PASSWORD=                 # used by docker-compose.yml
REDIS_URL=redis://localhost:6379/0 # Celery broker; not needed for `examradar run`

# Object storage for original documents
STORAGE_BACKEND=local              # local | s3
LOCAL_STORAGE_DIR=storage/objects
S3_ENDPOINT_URL=                   # e.g. http://minio:9000 or your provider's endpoint
S3_BUCKET=examradar-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1

# Crawler
CRAWLER_USER_AGENT=ExamRadarBot/0.1 (+https://github.com/Anirudh-1106/ExamRadar)
CRAWLER_DEFAULT_MIN_DELAY_SECONDS=5
CRAWLER_TIMEOUT_SECONDS=30
CRAWLER_EXTRA_CA_FILE=config/extra-ca.pem   # intermediate certificates some official sites fail to send

# Publication policy
AUTO_PUBLISH_REVISIONS=false       # false: changed dates wait for admin review
NEWS_MENTIONS_PUBLIC=true          # show unverified news headlines (with label) in the app
GOOGLE_NEWS_ENABLED=false          # Google News feeds stay off pending legal review

# LLM fallback (optional; the pipeline runs without it)
LLM_PROVIDER=none                  # groq | none
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Push notifications (optional; without them the app uses on-device reminders and the in-app inbox)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=         # path to the service account JSON, kept outside the repository

# Privacy
SCAM_TEXT_RETENTION_HOURS=24

# Logging
LOG_LEVEL=INFO
